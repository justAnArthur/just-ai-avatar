{
  "name": "@justanarthur/just-ai-avatar",
  "version": "0.5.0",
  "description": "AI avatars in glow, flat, plush and clay looks, with accessories and animated moods, as a Preact component",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justAnArthur/just-ai-avatar.git"
  },
  "homepage": "https://github.com/justAnArthur/just-ai-avatar#readme",
  "keywords": [
    "avatar",
    "ai",
    "preact",
    "css",
    "svg",
    "generator"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "import": "./dist/export.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "bun --hot ./playground/index.html",
    "build": "rm -rf dist && bun build ./src/index.ts ./src/server.ts ./src/element.ts ./src/export.ts --outdir dist --splitting --target browser --external preact --external preact-render-to-string --minify && tsc -p tsconfig.build.json && bun scripts/fix-dts.ts",
    "build:playground": "bun scripts/build-playground.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "properties": {
    "gitCommitScopeRelatedNames": "avatar,lib"
  },
  "peerDependencies": {
    "preact": "^11.0.0"
  },
  "dependencies": {
    "preact-render-to-string": "^6.8.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@types/bun": "^1.4.2",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.6",
    "lucide-react": "^1.49.0",
    "pdfjs-dist": "^6.3.289",
    "react": "npm:@preact/compat",
    "react-dom": "npm:@preact/compat",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}